        }
    }*/

    public boolean isValidPair(int prev, int curr) {

        if (curr == 0) {
            if (prev == 1 || prev == 2)
                return true;
            else
                return false;
        }

        if (prev == 1)
            return true;

        if (prev == 2 && curr <= 6) {
            return true;
        }

        return false;
    }
}
