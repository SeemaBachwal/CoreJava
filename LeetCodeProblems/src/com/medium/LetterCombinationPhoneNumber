class Solution {

    String[] letterDict = { "abc", "def", "ghi", "jkl", "mno", "pqrs", "tuv", "wxyz" };
    List<String> combos = new ArrayList<>();

    public List<String> letterCombinations(String digits) {

        // check for base condition
        if (digits == null || digits.length() == 0)
            return combos;

        helperCombo(0, digits, new StringBuilder());

        return combos;

    }

    public void helperCombo(int startIndex, String digits, StringBuilder curr) {

        if (startIndex == digits.length()) {

            combos.add(curr.toString());
            //System.out.println("\n************************** combos :: ******************   " + combos.toString());

            return;
        }

        String letters = letterDict[digits.charAt(startIndex) - '2'];
        //System.out.println("\nstartIndex ::  " + startIndex + "  letters  ::  " + letters);

        for (int i = 0; i < letters.length(); i++) {

            //System.out.println("i value -------------   >>>>>>>>     " + i);

            curr.append(letters.charAt(i));
            //System.out.println("curr post append :: " + curr.toString() + "   and startIndex value before helper   "+ startIndex);

            helperCombo(startIndex + 1, digits, curr);
            curr.deleteCharAt(curr.length() - 1);
            
            //System.out.println("curr post delete :: " + curr.toString());

        }

    }
}
